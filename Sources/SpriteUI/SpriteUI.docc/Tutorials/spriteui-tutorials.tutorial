@Tutorials(name: "SpriteUI") {
    @Intro(title: "Build an interactive SpriteUI scene") {
        Create a scene, give its entities frame-based behavior, steer around a wall, control a player with shared input actions, manipulate sprites directly, share devices between local players, render their shared world through independent viewports, and choose different world and map art with render layers.

        @Image(source: "spriteui-tutorial-hero.svg", alt: "Subtle cyan paths connect geometric nodes on a dark background.")
    }

    @Volume(name: "From your first sprite to local multiplayer") {
        Learn to retain a scene, schedule frame-based behavior, handle targeted input, guide a character around an obstruction, map on-screen and hardware controls to actions, drag, rotate, and scale sprites, assign devices to independent players, add split screen with a minimap, and filter camera visibility without stopping physics.

        @Image(source: "spriteui-tutorials-overview.svg", alt: "Eight tutorials progress from scene creation through movement, steering, input actions, manipulation, and local players to split screen, a minimap, and camera-specific artwork.")

        @Chapter(name: "Create and retain a scene") {
            Learn how a SwiftUI view owns an observable scene and adds entities to GameView.

            @Image(source: "spriteui-first-scene.svg", alt: "A cyan player and an orange destination inside a scene.")
            @TutorialReference(tutorial: "doc:creating-your-first-scene")
        }

        @Chapter(name: "Move with systems and input") {
            Schedule typed systems and respond to taps on the player.

            @Image(source: "spriteui-systems-input.svg", alt: "A tap on a cyan player reverses its motion between two limits.")
            @TutorialReference(tutorial: "doc:moving-with-systems-and-input")
        }

        @Chapter(name: "Steer through a scene with walls") {
            Turn steering forces into collision-aware movement and inspect the route with scene queries.

            @Image(source: "spriteui-steering-collision.svg", alt: "A cyan character follows a curved route above an orange wall to a green destination.")
            @TutorialReference(tutorial: "doc:steering-and-collision-aware-movement")
        }

        @Chapter(name: "Control a player with input actions") {
            Use on-screen buttons, poll held movement from a system, and add optional keyboard, pointer, and gamepad bindings. No physical input hardware is required.

            @Image(source: "spriteui-input-actions.svg", alt: "Virtual and hardware controls feed shared Move and Fire actions.")
            @TutorialReference(tutorial: "doc:controlling-a-player-with-input-actions")
        }

        @Chapter(name: "Manipulate sprites directly") {
            Opt into automatic gestures, constrain a child in parent-local space, and provide accessible session controls with safe physics release.

            @Image(source: "spriteui-manipulation.svg", alt: "A cyan sprite moves freely, a mint child follows a tilted rail, and an orange body resumes physics above a floor.")
            @TutorialReference(tutorial: "doc:manipulating-sprites-with-gestures")
        }

        @Chapter(name: "Share devices between players") {
            Route virtual pads to independent sessions, transfer held input safely, and adapt prompts and feedback to optional controllers.

            @Image(source: "spriteui-player-sessions.svg", alt: "Two virtual pads have exclusive player owners while an optional controller waits for assignment.")
            @TutorialReference(tutorial: "doc:sharing-devices-between-players")
        }

        @Chapter(name: "Share a world between viewports") {
            Follow independent players with two cameras, change layouts, and overlay a noninteractive minimap with scoped selection and labels.

            @Image(source: "spriteui-viewports.svg", alt: "One shared world is rendered through two player cameras and a view-only minimap.")
            @TutorialReference(tutorial: "doc:sharing-a-world-between-viewports")
        }

        @Chapter(name: "Choose artwork with render layers") {
            Give one physical object separate world and map artwork, hide visuals while physics continues, and select visible art in either pane.

            @Image(source: "spriteui-render-layers.svg", alt: "World squares and interactive map diamonds represent the same physical objects.")
            @TutorialReference(tutorial: "doc:presenting-a-world-with-render-layers")
        }
    }
}
