@Tutorials(name: "Learn SpriteUI") {
    @Intro(title: "Learn how a SpriteUI game works") {
        Start with a square on screen. Give it movement, put it under the player's control, and guide a character around a wall. Finish by switching rooms without losing the player's progress.

        The course is for SwiftUI developers who are new to SpriteUI. You do not need to know SpriteKit or have game artwork. Each lesson explains an idea, lets you see it running, and gives you a small change to try.

        @Image(source: "spriteui-first-scene-03-preview.svg", alt: "A cyan player, an orange destination, and a button that changes the player color.")
    }

    @Volume(name: "From a sprite to a game world") {
        Follow these five lessons in order. Use one SwiftUI app and replace ContentView.swift with the complete code for the stage you are working on. The examples are small so you can focus on one idea at a time.

        @Image(source: "spriteui-movement-03-preview.svg", alt: "The player moves across a game area with a pause button below it.")

        @Chapter(name: "1. Put a player on screen") {
            Learn what entities and components do, arrange two sprites, and change the player from a SwiftUI button.
            @Image(source: "spriteui-first-scene-03-preview.svg", alt: "Two sprites and a color button.")
            @TutorialReference(tutorial: "doc:creating-your-first-scene")
        }

        @Chapter(name: "2. Make the player move") {
            Store velocity in a component, apply it from a system, and reverse direction when the player is tapped.
            @Image(source: "spriteui-movement-03-preview.svg", alt: "A player patrols between two limits and responds to taps.")
            @TutorialReference(tutorial: "doc:moving-with-systems-and-input")
        }

        @Chapter(name: "3. Put the player under your control") {
            Read held movement and react once to a Fire press. Connect touch, keyboard, and controllers to the same game actions.
            @Image(source: "spriteui-input-actions-02-preview.svg", alt: "Directional controls move a cyan player.")
            @TutorialReference(tutorial: "doc:controlling-a-player-with-input-actions")
        }

        @Chapter(name: "4. Guide a character around a wall") {
            Understand the different jobs of steering, collision checks, and a route to follow.
            @Image(source: "spriteui-steering-04-preview.svg", alt: "A character follows a path above a wall.")
            @TutorialReference(tutorial: "doc:steering-and-collision-aware-movement")
        }

        @Chapter(name: "5. Change the room, keep the player") {
            Decide what belongs to a level and what should survive when the game loads another room.
            @Image(source: "spriteui-levels-02-preview.svg", alt: "A player keeps its score as Garden changes to Workshop.")
            @TutorialReference(tutorial: "doc:switching-levels-with-persistent-players")
        }
    }
}
