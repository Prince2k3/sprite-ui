@Tutorials(name: "SpriteUI") {
    @Intro(title: "Build an interactive SpriteUI scene") {
        Create a scene, give its entities frame-based behavior, steer around a wall, control a player with shared input actions, manipulate sprites directly, share devices between local players, render their shared world through independent viewports, choose different world and map art with render layers, add a repeating parallax landscape, switch levels while keeping player progress, adapt cameras and controls to reported surface regions, bind optional hinge input with portable virtual controls, and bound rendering while sharing completed game frames.

        @Image(source: "spriteui-tutorial-hero.svg", alt: "Subtle cyan paths connect geometric nodes on a dark background.")
    }

    @Volume(name: "From your first sprite to local multiplayer") {
        Learn to retain a scene, schedule frame-based behavior, handle targeted input, guide a character around an obstruction, map on-screen and hardware controls to actions, drag, rotate, and scale sprites, assign devices to independent players, add split screen with a minimap, filter camera visibility without stopping physics, scroll decorative artwork while preserving model anchors, replace physics rooms without replacing players, fit cameras and HUDs around reserved regions, explicitly assign calibrated hinge input, and publish bounded read-only game presentation.

        @Image(source: "spriteui-tutorials-overview.svg", alt: "Thirteen tutorials progress from scene creation through movement, steering, input actions, manipulation, and local players to split screen, camera-specific artwork, repeating parallax landscapes, persistent-player level transitions, adaptive game surfaces, optional hinge input with virtual fallbacks, and bounded rendering with read-only mirrors.")

        @Chapter(name: "Create and retain a scene") {
            Learn how a SwiftUI view owns an observable scene and adds entities to GameView.

            @Image(source: "spriteui-first-scene.svg", alt: "A cyan player and an orange destination inside a scene.")
            @TutorialReference(tutorial: "doc:creating-your-first-scene")
        }

        @Chapter(name: "Move with systems and input") {
            Schedule typed systems and respond to taps on the player.

            @Image(source: "spriteui-systems-input.svg", alt: "A tap on a cyan player reverses its motion between two limits.")
            @TutorialReference(tutorial: "doc:moving-with-systems-and-input")
        }

        @Chapter(name: "Steer through a scene with walls") {
            Turn steering forces into collision-aware movement and inspect the route with scene queries.

            @Image(source: "spriteui-steering-collision.svg", alt: "A cyan character follows a curved route above an orange wall to a green destination.")
            @TutorialReference(tutorial: "doc:steering-and-collision-aware-movement")
        }

        @Chapter(name: "Control a player with input actions") {
            Use on-screen buttons, poll held movement from a system, and add optional keyboard, pointer, and gamepad bindings. No physical input hardware is required.

            @Image(source: "spriteui-input-actions.svg", alt: "Virtual and hardware controls feed shared Move and Fire actions.")
            @TutorialReference(tutorial: "doc:controlling-a-player-with-input-actions")
        }

        @Chapter(name: "Manipulate sprites directly") {
            Opt into automatic gestures, constrain a child in parent-local space, and provide accessible session controls with safe physics release.

            @Image(source: "spriteui-manipulation.svg", alt: "A cyan sprite moves freely, a mint child follows a tilted rail, and an orange body resumes physics above a floor.")
            @TutorialReference(tutorial: "doc:manipulating-sprites-with-gestures")
        }

        @Chapter(name: "Share devices between players") {
            Route virtual pads to independent sessions, transfer held input safely, and adapt prompts and feedback to optional controllers.

            @Image(source: "spriteui-player-sessions.svg", alt: "Two virtual pads have exclusive player owners while an optional controller waits for assignment.")
            @TutorialReference(tutorial: "doc:sharing-devices-between-players")
        }

        @Chapter(name: "Share a world between viewports") {
            Follow independent players with two cameras, change layouts, and overlay a noninteractive minimap with scoped selection and labels.

            @Image(source: "spriteui-viewports.svg", alt: "One shared world is rendered through two player cameras and a view-only minimap.")
            @TutorialReference(tutorial: "doc:sharing-a-world-between-viewports")
        }

        @Chapter(name: "Choose artwork with render layers") {
            Give one physical object separate world and map artwork, hide visuals while physics continues, and select visible art in either pane.

            @Image(source: "spriteui-render-layers.svg", alt: "World squares and interactive map diamonds represent the same physical objects.")
            @TutorialReference(tutorial: "doc:presenting-a-world-with-render-layers")
        }

        @Chapter(name: "Build a repeating parallax landscape") {
            Generate seamless textures in code, scroll layers at different depths, and compare independent cameras while model anchors stay untouched.

            @Image(source: "spriteui-parallax.svg", alt: "Independent cameras show one star, mountain, and ground landscape at different scrolling depths.")
            @TutorialReference(tutorial: "doc:building-a-parallax-landscape")
        }

        @Chapter(name: "Switch levels with persistent players") {
            Prepare detached physics rooms, retain player progress and cameras, and control fade, crossfade, cancellation, and failure inside one game world.

            @Image(source: "spriteui-levels.svg", alt: "Garden and Workshop level roots share a persistent player, camera, and runtime sessions.")
            @TutorialReference(tutorial: "doc:switching-levels-with-persistent-players")
        }

        @Chapter(name: "Adapt to game surfaces") {
            Inspect active and inactive reserved regions, assign stable cameras, place fully fitting HUDs, and release virtual controls only when the effective layout changes.

            @Image(source: "spriteui-surfaces.svg", alt: "Two stable cameras and a fully fitting HUD avoid a reported division in one game surface.")
            @TutorialReference(tutorial: "doc:adapting-to-game-surfaces")
        }

        @Chapter(name: "Control a scene with hinge input") {
            Observe optional sensor data, share a calibrated action with virtual controls, and assign a native hinge explicitly to a player.

            @Image(source: "spriteui-hinge.svg", alt: "An optional live hinge and a virtual slider feed one calibrated action with explicit player ownership.")
            @TutorialReference(tutorial: "doc:controlling-a-scene-with-hinge-input")
        }

        @Chapter(name: "Bound rendering and share presentation") {
            Preserve point geometry while changing quality, monitor target reservations, and mirror existing frames with an optional OS external accessory.

            @Image(source: "spriteui-rendering.svg", alt: "One bounded primary canvas publishes completed frames through three reserved GPU buffers to passive mirrors.")
            @TutorialReference(tutorial: "doc:bounding-rendering-and-sharing-presentation")
        }
    }
}
